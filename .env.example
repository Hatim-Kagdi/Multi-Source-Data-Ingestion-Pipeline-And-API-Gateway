# ==============================================================================
# Enterprise Multi-Source Data Ingestion Pipeline & API Gateway Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="Enterprise Data Gateway"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000
WORKERS=1

# Redis Cache Settings
REDIS_URL="redis://localhost:6379/0"
REDIS_CACHE_TTL_SECONDS=300
REDIS_SOCKET_TIMEOUT=5.0
REDIS_MAX_CONNECTIONS=10

# External Ingestion Endpoints
EXTERNAL_API_BASE_URL="https://api.frankfurter.app"
SCRAPING_TARGET_URL="https://news.ycombinator.com"

# Network & Resilience Settings
HTTP_TIMEOUT_SECONDS=10.0
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_FACTOR=0.5
SCRAPER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36 DataGateway/1.0"

